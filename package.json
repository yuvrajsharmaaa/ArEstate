{
  "name": "kraystate-blockchain-platform",
  "version": "1.0.0",
  "description": "Blockchain-based tenant-landlord platform for Integra Chain with ERC-3643 compliance",
  "main": "index.js",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "deploy:testnet": "hardhat run scripts/deploy.js --network integra-testnet",
    "deploy:mainnet": "hardhat run scripts/deploy.js --network integra-mainnet",
    "verify": "hardhat verify",
    "lint": "solhint 'contracts/**/*.sol'",
    "format": "prettier --write 'contracts/**/*.sol'",
    "size": "hardhat size-contracts",
    "gas": "hardhat gas-reporter"
  },
  "keywords": [
    "blockchain",
    "real-estate",
    "tokenization",
    "ERC-3643",
    "compliance",
    "integra-chain",
    "tenant-landlord",
    "smart-contracts"
  ],
  "author": "KrayState Team",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.1",
    "@openzeppelin/hardhat-upgrades": "^2.4.0",
    "hardhat": "^2.19.0",
    "hardhat-contract-sizer": "^2.10.0",
    "hardhat-gas-reporter": "^1.0.9",
    "prettier": "^3.0.0",
    "prettier-plugin-solidity": "^1.1.3",
    "solhint": "^4.0.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.1",
    "@openzeppelin/contracts-upgradeable": "^5.0.1",
    "dotenv": "^16.3.1"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuvrajsharmaaa/KrayState.git"
  },
  "bugs": {
    "url": "https://github.com/yuvrajsharmaaa/KrayState/issues"
  },
  "homepage": "https://github.com/yuvrajsharmaaa/KrayState#readme"
}
